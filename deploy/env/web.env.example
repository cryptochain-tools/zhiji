# /etc/zhiji/web.env — root-owned, group-readable only by zhiji-web.
# Every placeholder below must be replaced on the target host; do not commit
# the resulting file or paste it into shell history.

# Egg HTTP listener. Nginx is the only public listener.
PORT=7011
EGG_SERVER_ENV=prod
APP_ORIGIN=https://zhiji.example.com

# Dedicated zhiji runtime account; never use the migration account here.
DATABASE_URL=postgresql://<zhiji_runtime_user>:<url-encoded-password>@127.0.0.1:5432/zhiji
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Generate with a cryptographically secure secret manager. Required in production.
SESSION_SECRET=<replace-with-long-random-secret>
INVITATION_OUTBOX_ENCRYPTION_KEY=<replace-with-32-byte-base64url-key>
OIDC_SECRET_ENCRYPTION_KEY=<replace-with-32-byte-base64url-key>

# Required only when behavior_capture is enabled. This server-held secret derives
# irreversible element keys from allowlisted client tokens; never expose it to SDKs.
BEHAVIOR_ELEMENT_KEY_SECRET=<replace-with-32-byte-base64url-key>

# Production private artifact storage. Set all six required S3 variables
# together on both web.env and worker.env. The endpoint must be HTTPS and the
# IAM/key policy must be limited to this bucket and prefix; it needs no public
# ACL, URL signing, ListBucket, or access to any other application's prefix. Values below
# are placeholders, not defaults. When any required S3 variable is present,
# the application rejects partial configuration and does not fall back to a
# local directory.
ZHIJI_ARTIFACT_S3_ENDPOINT=https://<private-s3-endpoint>
ZHIJI_ARTIFACT_S3_BUCKET=<zhiji-private-bucket>
ZHIJI_ARTIFACT_S3_PREFIX=zhiji/production
ZHIJI_ARTIFACT_S3_REGION=<s3-region>
ZHIJI_ARTIFACT_S3_ACCESS_KEY_ID=<artifact-writer-access-key-id>
ZHIJI_ARTIFACT_S3_SECRET_ACCESS_KEY=<artifact-writer-secret-access-key>
# Optional short-lived credential token. Omit this line for long-lived keys.
# ZHIJI_ARTIFACT_S3_SESSION_TOKEN=<artifact-session-token>
# The bucket must enforce encryption at rest. This value is sent on each PUT.
ZHIJI_ARTIFACT_S3_SERVER_SIDE_ENCRYPTION=AES256
# Alibaba Cloud OSS only: sign its required S3 compatibility request header.
# ZHIJI_ARTIFACT_S3_COMPATIBILITY=aliyun-oss

# Development-only private local fallback. Do not set these in a production
# S3 deployment; they must never be served by Nginx or share a public path.
REPLAY_ARTIFACT_DIR=/var/lib/zhiji-shared/replay-artifacts
SOURCEMAP_ARTIFACT_DIR=/var/lib/zhiji-shared/sourcemap-artifacts
ANALYTICS_EXPORT_ARTIFACT_DIR=/var/lib/zhiji-shared/export-artifacts

# Keep false until registration is intentionally opened.
ALLOW_SELF_REGISTRATION=false
