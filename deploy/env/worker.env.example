# /etc/zhiji/worker.env — root-owned, group-readable only by zhiji-worker.
# Use the dedicated zhiji runtime account, never another application's or migration URL.
DATABASE_URL=postgresql://<zhiji_runtime_user>:<url-encoded-password>@127.0.0.1:5432/zhiji
WORKER_ID=zhiji-worker-1
WORKER_DATABASE_POOL_MAX=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=30
REPORT_SCHEDULE_SCAN_INTERVAL_MS=60000
# Scans active projects and idempotently enqueues the daily retention and
# private Source Map cleanup jobs. Keep this below the retention SLA.
RETENTION_SCAN_INTERVAL_MS=21600000

# Production private artifact storage. These six required values must match
# web.env exactly so web and worker address the same opaque objects. The
# deployment key must be limited to the dedicated Zhiji bucket/prefix and
# must not grant public ACL, URL signing, or access outside the dedicated prefix.
ZHIJI_ARTIFACT_S3_ENDPOINT=https://<private-s3-endpoint>
ZHIJI_ARTIFACT_S3_BUCKET=<zhiji-private-bucket>
ZHIJI_ARTIFACT_S3_PREFIX=zhiji/production
ZHIJI_ARTIFACT_S3_REGION=<s3-region>
ZHIJI_ARTIFACT_S3_ACCESS_KEY_ID=<artifact-writer-access-key-id>
ZHIJI_ARTIFACT_S3_SECRET_ACCESS_KEY=<artifact-writer-secret-access-key>
# ZHIJI_ARTIFACT_S3_SESSION_TOKEN=<artifact-session-token>
ZHIJI_ARTIFACT_S3_SERVER_SIDE_ENCRYPTION=AES256
# Alibaba Cloud OSS only: sign its required S3 compatibility request header.
# ZHIJI_ARTIFACT_S3_COMPATIBILITY=aliyun-oss

# Development-only private local fallback. Do not set these in a production
# S3 deployment. Never place them under web dist or a Nginx-served directory.
REPLAY_ARTIFACT_DIR=/var/lib/zhiji-shared/replay-artifacts
SOURCEMAP_ARTIFACT_DIR=/var/lib/zhiji-shared/sourcemap-artifacts
ANALYTICS_EXPORT_ARTIFACT_DIR=/var/lib/zhiji-shared/export-artifacts

# External delivery remains disabled unless both a transport and a target entry
# are configured. Keep this root-owned file out of the repository.
PUBLIC_APP_URL=https://zhiji.example.com
INVITATION_OUTBOX_ENCRYPTION_KEY=<same-32-byte-base64url-key-as-web>
SMTP_URL=smtps://<url-encoded-user>:<url-encoded-password>@<approved-smtp-host>:465
SMTP_FROM=notifications@<approved-sender-domain>
SMTP_ALLOWED_HOSTS=smtp.example.com
# Exact DNS suffixes for generic HTTPS targets. Empty means generic webhooks
# are disabled. lark_bot is always restricted to open.feishu.cn.
OUTBOUND_HTTPS_ALLOWLIST=hooks.example.com
# Map target UUIDs to deployment-owned transport secrets; these values never
# enter the database, API response, audit log or outbox payload.
NOTIFICATION_DELIVERY_TARGETS='{"<target-uuid>":{"type":"webhook","url":"https://hooks.example.com/zhiji","signing_secret":"<secret>"}}'
