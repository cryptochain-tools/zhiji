# /etc/zhiji/backup.env — root-owned, readable only by the backup operator.
# Use a dedicated read-only zhiji backup role. Never reuse another application's credentials.
DATABASE_URL=postgresql://<zhiji_backup_user>:<url-encoded-password>@127.0.0.1:5432/zhiji

# Production artifacts live in a private S3-compatible bucket/prefix. Create
# a provider-native, immutable snapshot/export with a separate backup identity
# before invoking backup-local.sh, then stage only that snapshot directory for
# tar packaging. backup-local.sh deliberately does not receive S3 credentials,
# enumerate a bucket, or make network calls beyond PostgreSQL.
# Artifact snapshot metadata passed on the command line must identify the
# provider snapshot/export and its immutable version or timestamp; do not put
# endpoint URLs, object keys, credentials, or customer content in the manifest.
