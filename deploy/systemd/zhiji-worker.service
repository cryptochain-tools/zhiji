[Unit]
Description=Zhiji background worker
Documentation=file:///opt/zhiji/current/deploy/README.md
After=network-online.target zhiji-web.service
Wants=network-online.target

[Service]
Type=simple
User=zhiji-worker
Group=zhiji-worker
WorkingDirectory=/opt/zhiji/current
Environment=HOME=/var/lib/zhiji-worker
Environment=NODE_ENV=production
EnvironmentFile=/etc/zhiji/worker.env
ExecStart=/usr/local/bin/pnpm --dir /opt/zhiji/current/apps/worker start
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
MemoryMax=512M
CPUQuota=100%
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhiji-shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
StateDirectory=zhiji-worker
RuntimeDirectory=zhiji-worker
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zhiji-worker

[Install]
WantedBy=multi-user.target
